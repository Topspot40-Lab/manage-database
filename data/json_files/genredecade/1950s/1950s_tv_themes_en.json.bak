    { "track_id": "58tIaHOLyqe6Q7M9pZe9GX", "track_name": "Peter Gunn", "artist_name": "henry mancini", "rank": 1, "genre": "tv themes", "decade": "1950s", "tracklist": "TopSpot Autogen", "intro": "Kicking off our 1950s set, here's the moody, detective-noir theme to Peter Gunn (1958–1961), a hard-boiled crime series steeped in cool-jazz swagger.", "created_at": "2025-09-05" },
