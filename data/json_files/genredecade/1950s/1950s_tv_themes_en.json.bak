    { "track_id": "7yr5ZuZqagB3Z5SRhCcs5x", "track_name": "Rawhide", "artist_name": "frankie laine", "rank": 3, "genre": "tv themes", "decade": "1950s", "tracklist": "TopSpot Autogen", "intro": "Saddle up for Rawhide (1959–1965), a trail-drive western whose theme cracks like a whip—pure 1950s TV frontier energy.", "created_at": "2025-09-05" },
    { "track_id": "5xGZJssVyYCWc5MzWxiXCC", "track_name": "Bonanza (Main Theme)", "artist_name": "david rose", "rank": 4, "genre": "tv themes", "decade": "1950s", "tracklist": "TopSpot Autogen", "intro": "Next, the stampeding fanfare of Bonanza (1959–1973), a long-running western about the Cartwrights on the Ponderosa.", "created_at": "2025-09-05" },
    { "track_id": "5TMudJQG4Pb4PneHIhtgA0", "track_name": "Mickey Mouse March (From 'The Mickey Mouse Club')", "artist_name": "jimmie dodd & the mouseketeers", "rank": 5, "genre": "tv themes", "decade": "1950s", "tracklist": "TopSpot Autogen", "intro": "From children's variety to cultural phenomenon: The Mickey Mouse Club (1955–1959) welcomes you with its peppy march and roll-call chorus.", "created_at": "2025-09-05" },
    { "track_id": "604ZpOVApaeGoMOzOm8lUE", "track_name": "Funeral March of a Marionette (Theme from 'Alfred Hitchcock Presents')", "artist_name": "charles gounod", "rank": 6, "genre": "tv themes", "decade": "1950s", "tracklist": "TopSpot Autogen", "intro": "Cue the sly grin: Alfred Hitchcock Presents (1955–1965) steps in with a wry, tip-toeing theme—Gounod's â€˜Funeral March of a Marionette.'", "created_at": "2025-09-05" },
    { "track_id": "1NbD8eCoSrmFA8sNrZZTvz", "track_name": "William Tell Overture: Finale (Theme from 'The Lone Ranger')", "artist_name": "gioachino rossini", "rank": 7, "genre": "tv themes", "decade": "1950s", "tracklist": "TopSpot Autogen", "intro": "Hi-Yo, Silver! The Lone Ranger (TV 1949–1957) thundered onto '50s screens with the racing finale of Rossini's â€˜William Tell' Overture.", "created_at": "2025-09-05" },
    { "track_id": "1rmylYvGOcSzJ5AZ4BSHbr", "track_name": "Superman Main Title (From 'Adventures of Superman')", "artist_name": "leon klatzkin", "rank": 8, "genre": "tv themes", "decade": "1950s", "tracklist": "TopSpot Autogen", "intro": "Look! Up in the sky! Adventures of Superman (1952–1958) soars with a brassy fanfare that promises truth, justice, and mid-century adventure.", "created_at": "2025-09-05" },
    { "track_id": "5aIlwCsfbagxrVIAVDGiaA", "track_name": "The Ballad of Paladin (From 'Have Gun – Will Travel')", "artist_name": "johnny western", "rank": 9, "genre": "tv themes", "decade": "1950s", "tracklist": "TopSpot Autogen", "intro": "Holster-smooth and laconic, â€˜The Ballad of Paladin' introduces Have Gun – Will Travel (1957–1963), a gentleman-gunfighter western.", "created_at": "2025-09-05" },
    { "track_id": "5XC7tebqGPQNXDQImgOhcZ", "track_name": "The Rifleman", "artist_name": "herschel burke gilbert", "rank": 10, "genre": "tv themes", "decade": "1950s", "tracklist": "TopSpot Autogen", "intro": "With rapid-fire snare and bold brass, The Rifleman (1958–1963) announces a frontier drama about resolve, family, and frontier law.", "created_at": "2025-09-05" },
    { "track_id": "5LeCbkjJuhtqQhwXziPgUn", "track_name": "Dragnet (Main Theme)", "artist_name": "walter schumann", "rank": 11, "genre": "tv themes", "decade": "1950s", "tracklist": "TopSpot Autogen", "intro": "Just the facts: Dragnet (1951–1959) punctuates L.A. police procedurals with a four-note motif as stark as a badge number.", "created_at": "2025-09-05" },
