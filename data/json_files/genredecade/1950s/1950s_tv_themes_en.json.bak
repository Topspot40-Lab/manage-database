      "show_genre": "Crime/Procedural",
      "years_on_air": "1951–1959",
      "artist_description": "American composer and choral director; crafted Dragnet's terse four-note motif—an audio icon of procedural TV.",
      "artist_artwork": "https://i.scdn.co/image/73eea870d552ddaa17b1678af1efa4a90289b9c7"
    },
